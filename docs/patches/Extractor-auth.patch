+    private void fetchAuthenticatedPlayer(
+            org.schabi.newpipe.extractor.services.youtube.AuthenticatedPlayerProvider.Response auth,
+            Localization localization, ContentCountry contentCountry, String videoId)
+            throws IOException, ExtractionException {
+        playerResponse = auth.player;
+        checkPlayabilityStatus(playerResponse.getObject(PLAYABILITY_STATUS));
+        if (isPlayerResponseNotValid(playerResponse, videoId)) {
+            throw new ExtractionException("AUTH_PLAYER_RESPONSE_MISMATCH");
+        }
+        androidCpn = auth.cpn;
+        androidStreamingUrlsPoToken = auth.streamingPoToken;
+        androidStreamingData = playerResponse.getObject(STREAMING_DATA);
+        // SABR is a session protocol, never treat its serverAbrStreamingUrl as a file URL.
+        if (androidStreamingData.containsKey("serverAbrStreamingUrl")
+                && !hasAuthenticatedDirectFormats(androidStreamingData)) {
+            throw new ExtractionException("AUTH_SABR_BACKEND_REQUIRED");
+        }
+        setStreamType();
+        playerCaptionsTracklistRenderer = playerResponse.getObject(CAPTIONS)
+                .getObject(PLAYER_CAPTIONS_TRACKLIST_RENDERER);
+        playerMicroFormatRenderer = playerResponse.getObject("microformat")
+                .getObject("playerMicroformatRenderer");
+        thumbnailsArray = playerResponse.getObject(VIDEO_DETAILS)
+                .getObject(THUMBNAIL).getArray(THUMBNAILS);
+        final byte[] nextBody = JsonWriter.string(
+                prepareDesktopJsonBuilder(localization, contentCountry)
+                        .value(VIDEO_ID, videoId).value(CONTENT_CHECK_OK, true)
+                        .value(RACY_CHECK_OK, true).done()).getBytes(StandardCharsets.UTF_8);
+        // Metadata browsing stays anonymous, matching the auth boundary.
+        try {
+            nextResponse = getJsonPostResponse(NEXT, nextBody, localization);
+        } catch (IOException | ExtractionException error) {
+            nextResponse = new JsonObject();
+            // Optional anonymous metadata failed; authenticated playback data remains usable.
+        }
+        if (!auth.isCurrent.getAsBoolean()) {
+            throw new ExtractionException("AUTH_SESSION_CHANGED");
+        }
+    }
+
+    private static boolean hasAuthenticatedDirectFormats(JsonObject data) {
+        for (String key : Arrays.asList(FORMATS, ADAPTIVE_FORMATS)) {
+            JsonArray formats = data.getArray(key);
+            if (formats == null) { continue; }
+            for (Object value : formats) {
+                if (!(value instanceof JsonObject)) { continue; }
+                JsonObject format = (JsonObject) value;
+                if (!format.getString("url", "").isEmpty()
+                        || !format.getString("signatureCipher", "").isEmpty()
+                        || !format.getString("cipher", "").isEmpty()) { return true; }
+            }
+        }
+        return false;
     }
 
